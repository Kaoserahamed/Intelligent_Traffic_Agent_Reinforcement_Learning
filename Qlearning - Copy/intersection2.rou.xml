<?xml version="1.0" encoding="UTF-8"?>
<routes>
    <!-- Vehicle Types with Enhanced Design -->
    <vType id="car" accel="2.6" decel="4.5" sigma="0.5" length="4.5" minGap="2.5" maxSpeed="2"
           guiShape="passenger" color="0.7,0.2,0.2" imgFile="standard/car.png"
           width="1.8" carFollowModel="IDM" speedFactor="1.2">
        <param key="has.railway.device" value="false"/>
        <param key="has.taxi.device" value="false"/>
    </vType>
    
    <vType id="bus" accel="1.2" decel="4.0" sigma="0.5" length="7" minGap="2.5" maxSpeed="3"
           guiShape="bus" color="0,0.7,0.7" imgFile="standard/bus.png"
           width="2.5" carFollowModel="IDMM" speedFactor="1.0">
        <param key="has.railway.device" value="false"/>
        <param key="has.taxi.device" value="false"/>
    </vType>
    
    <vType id="emergency" accel="3.0" decel="6.0" sigma="0.5" length="5" minGap="2.5" maxSpeed="4"
           guiShape="emergency" color="1,1,1" imgFile="emergency/ambulance.png"
           width="2.0" carFollowModel="IDM" speedFactor="1.5">
        <param key="has.railway.device" value="false"/>
    </vType>
    
    <vType id="truck" accel="1.0" decel="4.0" sigma="0.5" length="8" minGap="2.5" maxSpeed="2"
           guiShape="truck" color="0.8,0.4,0" imgFile="standard/truck.png"
           width="2.6" carFollowModel="IDMM" speedFactor="0.9">
        <param key="has.railway.device" value="false"/>
    </vType>
    
    <vType id="bike" vClass="motorcycle" accel="2.5" decel="7.0" sigma="0.9" length="2.0" maxSpeed="5"
           guiShape="motorcycle" color="1,0.5,0" imgFile="standard/motorcycle.png"
           width="1.0" carFollowModel="IDM" speedFactor="1.3">
        <param key="has.railway.device" value="false"/>
    </vType>

    <!-- Routes Definition -->
    <route id="n_s" edges="3to1 1to5"/>
    <route id="n_w" edges="3to1 1to4"/>
    <route id="n_e" edges="3to1 1to2"/>
    
    <route id="s_n" edges="5to1 1to3"/>
    <route id="s_w" edges="5to1 1to4"/>
    <route id="s_e" edges="5to1 1to2"/>
    
    <route id="e_w" edges="2to1 1to4"/>
    <route id="e_n" edges="2to1 1to3"/>
    <route id="e_s" edges="2to1 1to5"/>
    
    <route id="w_e" edges="4to1 1to2"/>
    <route id="w_n" edges="4to1 1to3"/>
    <route id="w_s" edges="4to1 1to5"/>

    <!-- BALANCED BUT VARIED TRAFFIC FLOWS -->
    
    <!-- NORTHBOUND (Total: ~250 veh/h) -->
    <flow id="north_straight" type="car" route="n_s" begin="0" end="7200" vehsPerHour="100"/>
    <flow id="north_left" type="car" route="n_w" begin="0" end="7200" vehsPerHour="80"/>
    <flow id="north_right" type="car" route="n_e" begin="0" end="7200" vehsPerHour="20"/>
    <flow id="north_bus" type="bus" route="n_s" begin="0" end="7200" vehsPerHour="12"/>
    <flow id="north_emergency" type="emergency" route="n_s" begin="0" end="7200" vehsPerHour="3"/>

    <!-- SOUTHBOUND (Total: ~320 veh/h) -->
    <flow id="south_straight" type="car" route="s_n" begin="0" end="7200" vehsPerHour="150"/>
    <flow id="south_left" type="car" route="s_w" begin="0" end="7200" vehsPerHour="100"/>
    <flow id="south_right" type="car" route="s_e" begin="0" end="7200" vehsPerHour="30"/>
    <flow id="south_bus" type="bus" route="s_n" begin="0" end="7200" vehsPerHour="15"/>
    <flow id="south_truck" type="truck" route="s_n" begin="0" end="7200" vehsPerHour="3"/>
    <flow id="south_emergency" type="emergency" route="s_w" begin="0" end="7200" vehsPerHour="2"/>

    <!-- EASTBOUND (Total: ~280 veh/h) -->
    <flow id="east_straight" type="car" route="e_w" begin="0" end="7200" vehsPerHour="130"/>
    <flow id="east_left" type="car" route="e_n" begin="0" end="7200" vehsPerHour="80"/>
    <flow id="east_right" type="car" route="e_s" begin="0" end="7200" vehsPerHour="20"/>
    <flow id="east_bus" type="bus" route="e_w" begin="0" end="7200" vehsPerHour="14"/>
    <flow id="east_bike" type="bike" route="e_s" begin="0" end="7200" vehsPerHour="4"/>
    <flow id="east_emergency" type="emergency" route="e_n" begin="0" end="7200" vehsPerHour="2"/>

    <!-- WESTBOUND (Total: ~200 veh/h) -->
    <flow id="west_straight" type="car" route="w_e" begin="0" end="7200" vehsPerHour="80"/>
    <flow id="west_left" type="car" route="w_n" begin="0" end="7200" vehsPerHour="70"/>
    <flow id="west_right" type="car" route="w_s" begin="0" end="7200" vehsPerHour="15"/>
    <flow id="west_bus" type="bus" route="w_e" begin="0" end="7200" vehsPerHour="10"/>
    <flow id="west_truck" type="truck" route="w_e" begin="0" end="7200" vehsPerHour="6"/>
    <flow id="west_bike" type="bike" route="w_s" begin="0" end="7200" vehsPerHour="2"/>
    <flow id="west_emergency" type="emergency" route="w_n" begin="0" end="7200" vehsPerHour="2"/>
</routes>
