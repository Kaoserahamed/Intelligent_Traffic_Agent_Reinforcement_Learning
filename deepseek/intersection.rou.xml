<routes>
    <vType id="car" accel="2.6" decel="4.5" sigma="0.5" length="5" maxSpeed="50"/>
    
    <!-- Northbound routes -->
    <route id="n_s" edges="3to1 1to5"/>
    <route id="n_w" edges="3to1 1to4"/>
    <route id="n_e" edges="3to1 1to2"/>
    
    <!-- Southbound routes -->
    <route id="s_n" edges="5to1 1to3"/>
    <route id="s_w" edges="5to1 1to4"/>
    <route id="s_e" edges="5to1 1to2"/>
    
    <!-- Eastbound routes -->
    <route id="e_w" edges="2to1 1to4"/>
    <route id="e_n" edges="2to1 1to3"/>
    <route id="e_s" edges="2to1 1to5"/>
    
    <!-- Westbound routes -->
    <route id="w_e" edges="4to1 1to2"/>
    <route id="w_n" edges="4to1 1to3"/>
    <route id="w_s" edges="4to1 1to5"/>
    
    <!-- Traffic flows -->
    <flow id="north_straight" type="car" route="n_s" begin="0" end="7200" vehsPerHour="400"/>
    <flow id="north_left" type="car" route="n_w" begin="0" end="7200" vehsPerHour="200"/>
    <flow id="north_right" type="car" route="n_e" begin="0" end="7200" vehsPerHour="200"/>
    
    <flow id="south_straight" type="car" route="s_n" begin="0" end="7200" vehsPerHour="400"/>
    <flow id="south_left" type="car" route="s_w" begin="0" end="7200" vehsPerHour="200"/>
    <flow id="south_right" type="car" route="s_e" begin="0" end="7200" vehsPerHour="200"/>
    
    <flow id="east_straight" type="car" route="e_w" begin="0" end="7200" vehsPerHour="400"/>
    <flow id="east_left" type="car" route="e_n" begin="0" end="7200" vehsPerHour="200"/>
    <flow id="east_right" type="car" route="e_s" begin="0" end="7200" vehsPerHour="200"/>
    
    <flow id="west_straight" type="car" route="w_e" begin="0" end="7200" vehsPerHour="400"/>
    <flow id="west_left" type="car" route="w_n" begin="0" end="7200" vehsPerHour="200"/>
    <flow id="west_right" type="car" route="w_s" begin="0" end="7200" vehsPerHour="200"/>
</routes>