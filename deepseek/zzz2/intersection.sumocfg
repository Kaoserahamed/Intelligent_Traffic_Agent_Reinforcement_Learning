<configuration>
    <input>
        <net-file value="intersection.net.xml"/>
        <route-files value="intersection.rou.xml"/>
        <additional-files value="intersection.add.xml"/>
        <gui-settings-file value="gui-settings.xml"/>
    </input>
    <processing>
        <ignore-route-errors value="true"/>
        <tls.actuated.jam-threshold value="30"/>
    </processing>
    <time>
        <begin value="0"/>
        <end value="7200"/>
    </time>
    <additionals>
    <poly id="crosswalk1" shape="10,10 20,10 20,15 10,15" color="black" fill="true" layer="1"/>
    <poi id="shop1" x="15" y="12" color="red" type="commercial"/>
    </additionals>
</configuration>