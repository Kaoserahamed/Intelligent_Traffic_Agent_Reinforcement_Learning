<viewsettings>
    <scheme name="real world"/>
    <delay value="50"/>
    <viewport zoom="300" x="0" y="0"/>
    <light-positions centerX="0" centerY="0"/>
    <background-color value="71,98,122"/>
    <breakpoints-file value="breakpoints.txt"/>
    
    <gui-settings>
        <show-lane-direction value="true"/>
        <show-link-junction-index value="true"/>
        <show-link-tls-index value="true"/>
        <show-connections value="true"/>
        <show-tls-link-ids value="true"/>
        <show-junctions-shape value="true"/>
        <show-lane-ids value="false"/>
        <show-edge-ids value="false"/>
        <show-tls-states value="true"/>
    </gui-settings>
    
    <vehicles vehicleMode="10" vehicleQuality="3" minVehicleSize="1.00" vehicleExaggeration="1.00" showBlinker="true"
              vehicleName_show="false" vehicleName_size="50.00" vehicleName_color="0,0,0" >
        <colorScheme name="by vehicle type">
            <entry color="1,0,0" name="car"/>
            <entry color="0,1,0" name="bus"/>
            <entry color="0,0,1" name="motorcycle"/>
        </colorScheme>
    </vehicles>
    
    <junctions junctionMode="0" drawLinkTLIndex="0" drawLinkJunctionIndex="0" junctionName_show="false" 
               junctionName_size="50.00" junctionName_color="0,0,255" 
               showLane2Lane="false" drawShape="true" drawCrossingsAndWalkingareas="true" />
    
    <legend showSizeLegend="true" />
</viewsettings>