<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    
    <vType id="car" accel="2.6" decel="4.5" length="4.5" minGap="2.5" maxSpeed="13.89" color="1,1,0"/>
    <vType id="bus" accel="1.5" decel="3.0" length="12" minGap="3" maxSpeed="11.11" color="0,1,0"/>
    <vType id="truck" accel="1.2" decel="3.0" length="7.5" minGap="3" maxSpeed="10" color="1,0,0"/>

    <route id="route_north_south" edges="north_to_center center_to_south"/>
    <route id="route_south_north" edges="south_to_center center_to_north"/>
    <route id="route_east_west" edges="east_to_center center_to_west"/>
    <route id="route_west_east" edges="west_to_center center_to_east"/>

    <flow id="car_flow_north_south" type="car" route="route_north_south" begin="0" end="3600" vehsPerHour="300"/>
    <flow id="car_flow_south_north" type="car" route="route_south_north" begin="0" end="3600" vehsPerHour="300"/>
    <flow id="bus_flow_east_west" type="bus" route="route_east_west" begin="0" end="3600" vehsPerHour="50"/>
    <flow id="truck_flow_west_east" type="truck" route="route_west_east" begin="0" end="3600" vehsPerHour="100"/>
</routes>