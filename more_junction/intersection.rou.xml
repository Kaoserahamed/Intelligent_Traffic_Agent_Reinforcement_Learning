    <!-- Reverse flows -->
    <flow id="flow_6to3_cars" type="passenger_car" route="route_6to3" begin="0" end="3600" vehsPerHour="280"/>
    <flow id="flow_6to3_suv" type="suv" route="route_6to3" begin="0" end="3600" vehsPerHour="130"/>
