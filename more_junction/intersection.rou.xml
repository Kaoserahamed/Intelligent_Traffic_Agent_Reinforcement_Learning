<?xml version="1.0" encoding="UTF-8"?>
<routes>
    <!-- Vehicle types with different properties -->
    <vType id="passenger_car" accel="2.6" decel="4.5" sigma="0.5" length="5.0" minGap="2.5" maxSpeed="55.0" guiShape="passenger" color="0,0,255"/>
    <vType id="suv" accel="2.0" decel="4.0" sigma="0.5" length="5.5" minGap="2.5" maxSpeed="50.0" guiShape="passenger/van" color="255,0,0"/>
    <vType id="truck" accel="1.3" decel="3.0" sigma="0.5" length="12.0" minGap="3.0" maxSpeed="40.0" guiShape="truck" color="0,255,0"/>
    <vType id="bus" accel="1.2" decel="3.0" sigma="0.5" length="15.0" minGap="3.0" maxSpeed="35.0" guiShape="bus" color="255,255,0"/>
    <vType id="motorcycle" accel="3.5" decel="5.0" sigma="0.5" length="2.5" minGap="1.5" maxSpeed="60.0" guiShape="motorcycle" color="255,0,255"/>
    
    <!-- Routes definition -->
    <!-- Forward -->
    <route id="route_3to6" edges="3to1 1to5 5to6" color="255,0,0"/>
    <route id="route_4to6" edges="4to1 1to5 5to6" color="0,255,0"/>
    <route id="route_2to6" edges="2to1 1to5 5to6" color="0,0,255"/>
    <route id="route_8to6" edges="8to5 5to6" color="255,255,0"/>
    <route id="route_7to6" edges="7to5 5to6" color="255,0,255"/>

    <!-- Reverse -->
    <route id="route_6to3" edges="6to5 5to1 1to3" color="200,100,100"/>
    <route id="route_6to4" edges="6to5 5to1 1to4" color="100,200,100"/>
    <route id="route_6to2" edges="6to5 5to1 1to2" color="100,100,200"/>
    <route id="route_6to8" edges="6to5 5to8" color="200,200,0"/>
    <route id="route_6to7" edges="6to5 5to7" color="200,0,200"/>

    <!-- Traffic flows -->
    <!-- Forward flows -->
    <flow id="flow_3to6_cars" type="passenger_car" route="route_3to6" begin="0" end="3600" vehsPerHour="300"/>
    <flow id="flow_3to6_suv" type="suv" route="route_3to6" begin="0" end="3600" vehsPerHour="150"/>
    <flow id="flow_3to6_motorbike" type="motorcycle" route="route_3to6" begin="0" end="3600" vehsPerHour="80"/>
    
    <flow id="flow_4to6_cars" type="passenger_car" route="route_4to6" begin="0" end="3600" vehsPerHour="400"/>
