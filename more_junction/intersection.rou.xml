    <flow id="flow_4to6_bus" type="bus" route="route_4to6" begin="0" end="3600" vehsPerHour="30"/>
    
    <flow id="flow_2to6_cars" type="passenger_car" route="route_2to6" begin="0" end="3600" vehsPerHour="250"/>
    <flow id="flow_2to6_suv" type="suv" route="route_2to6" begin="0" end="3600" vehsPerHour="120"/>
    
    <flow id="flow_8to6_cars" type="passenger_car" route="route_8to6" begin="0" end="3600" vehsPerHour="350"/>
    <flow id="flow_8to6_motorcycle" type="motorcycle" route="route_8to6" begin="0" end="3600" vehsPerHour="100"/>
    
    <flow id="flow_7to6_cars" type="passenger_car" route="route_7to6" begin="0" end="3600" vehsPerHour="200"/>
