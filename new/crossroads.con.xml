<?xml version="1.0" encoding="UTF-8"?>
<connections xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/connections_file.xsd">
    <!-- North to South (straight) - Left-side driving -->
     <connection from="north_to_center" to="center_to_south" fromLane="0" toLane="0"/>
     <connection from="north_to_center" to="center_to_south" fromLane="1" toLane="1"/>
    <connection from="north_to_center" to="center_to_south" fromLane="2" toLane="2"/>
    
   
    
    <!-- North to East (left turn) - Using leftmost lane -->
    <connection from="north_to_center" to="center_to_east" fromLane="2" toLane="2"/>
    
    <!-- North to West (right turn) - Using rightmost lane -->
    <connection from="north_to_center" to="center_to_west" fromLane="0" toLane="0"/>
    
    <!-- South to North - Left-side driving -->
    <connection from="south_to_center" to="center_to_north" fromLane="2" toLane="2"/>
    <connection from="south_to_center" to="center_to_north" fromLane="1" toLane="1"/>
    <connection from="south_to_center" to="center_to_north" fromLane="0" toLane="0"/>
    
    <!-- South to West (left turn) - Using leftmost lane -->
    <connection from="south_to_center" to="center_to_west" fromLane="2" toLane="2"/>
    
    <!-- South to East (right turn) - Using rightmost lane -->
    <connection from="south_to_center" to="center_to_east" fromLane="0" toLane="0"/>
    
    <!-- East to West - Left-side driving -->
    <connection from="east_to_center" to="center_to_west" fromLane="2" toLane="2"/>
    <connection from="east_to_center" to="center_to_west" fromLane="1" toLane="1"/>
    <connection from="east_to_center" to="center_to_west" fromLane="0" toLane="0"/>
    
    <!-- East to North (left turn) - Using leftmost lane -->
    <connection from="east_to_center" to="center_to_north" fromLane="2" toLane="2"/>
    
    <!-- East to South (right turn) - Using rightmost lane -->
    <connection from="east_to_center" to="center_to_south" fromLane="0" toLane="0"/>
    
    <!-- West to East - Left-side driving -->
    <connection from="west_to_center" to="center_to_east" fromLane="2" toLane="2"/>
    <connection from="west_to_center" to="center_to_east" fromLane="1" toLane="1"/>
    <connection from="west_to_center" to="center_to_east" fromLane="0" toLane="0"/>
    
    <!-- West to South (left turn) - Using leftmost lane -->
    <connection from="west_to_center" to="center_to_south" fromLane="2" toLane="2"/>
    
    <!-- West to North (right turn) - Using rightmost lane -->
    <connection from="west_to_center" to="center_to_north" fromLane="0" toLane="0"/>
</connections>