<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    <!-- Define vehicle types -->
    <vType id="car" accel="2.6" decel="4.5" sigma="0.5" length="5" minGap="2.5" maxSpeed="50" guiShape="passenger" color="1,0,0"/>
    <vType id="bus" accel="1.2" decel="4.0" sigma="0.5" length="12" minGap="2.5" maxSpeed="30" guiShape="bus" color="0,1,1"/>
    <vType id="emergency" accel="3.0" decel="6.0" sigma="0.5" length="5" minGap="2.5" maxSpeed="60" guiShape="emergency" color="1,1,1"/>
    <vType id="truck" accel="1.0" decel="4.0" sigma="0.5" length="15" minGap="2.5" maxSpeed="25" guiShape="truck" color="1,0.5,0"/>
    
    <!-- Define routes -->
    <route id="north_to_south" edges="north_to_center center_to_south"/>
    <route id="north_to_east" edges="north_to_center center_to_east"/>
    <route id="north_to_west" edges="north_to_center center_to_west"/>
    
    <route id="south_to_north" edges="south_to_center center_to_north"/>
    <route id="south_to_east" edges="south_to_center center_to_east"/>
    <route id="south_to_west" edges="south_to_center center_to_west"/>
    
    <route id="east_to_west" edges="east_to_center center_to_west"/>
    <route id="east_to_north" edges="east_to_center center_to_north"/>
    <route id="east_to_south" edges="east_to_center center_to_south"/>
    
    <route id="west_to_east" edges="west_to_center center_to_east"/>
    <route id="west_to_north" edges="west_to_center center_to_north"/>
    <route id="west_to_south" edges="west_to_center center_to_south"/>
    
    <!-- Define traffic flow -->
    <!-- Cars -->
    <flow id="flow_car_north_south" type="car" route="north_to_south" begin="0" end="3600" vehsPerHour="300"/>
    <flow id="flow_car_south_north" type="car" route="south_to_north" begin="0" end="3600" vehsPerHour="300"/>
    <flow id="flow_car_east_west" type="car" route="east_to_west" begin="0" end="3600" vehsPerHour="300"/>
    <flow id="flow_car_west_east" type="car" route="west_to_east" begin="0" end="3600" vehsPerHour="300"/>
    
    <!-- Buses -->
    <flow id="flow_bus_north_south" type="bus" route="north_to_south" begin="0" end="3600" vehsPerHour="30"/>
    <flow id="flow_bus_south_north" type="bus" route="south_to_north" begin="0" end="3600" vehsPerHour="30"/>
    <flow id="flow_bus_east_west" type="bus" route="east_to_west" begin="0" end="3600" vehsPerHour="30"/>
    <flow id="flow_bus_west_east" type="bus" route="west_to_east" begin="0" end="3600" vehsPerHour="30"/>
    
    <!-- Trucks -->
    <flow id="flow_truck_north_south" type="truck" route="north_to_south" begin="0" end="3600" vehsPerHour="50"/>
    <flow id="flow_truck_east_west" type="truck" route="east_to_west" begin="0" end="3600" vehsPerHour="50"/>
    
    <!-- Emergency vehicles (occasional) -->
    <vehicle id="emergency_1" type="emergency" route="north_to_south" depart="100"/>
    <vehicle id="emergency_2" type="emergency" route="west_to_east" depart="300"/>
    <vehicle id="emergency_3" type="emergency" route="east_to_west" depart="500"/>
    <vehicle id="emergency_4" type="emergency" route="south_to_north" depart="700"/>
</routes>