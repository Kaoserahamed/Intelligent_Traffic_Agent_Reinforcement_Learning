# =============================================================================
# TrafficRL environment configuration - TEMPLATE (no real secrets!)
# =============================================================================
# Copy to `.env` and fill in per environment:
#     cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
#
# * `.env` is git-ignored and must never be committed.
# * In CI/CD nothing is read from a committed file: GitHub Actions passes the
#   non-secret values as repository variables and authenticates to AWS with
#   OIDC; runtime secrets come from AWS Secrets Manager / SSM Parameter Store.
# * Every variable below maps 1:1 to a field in `traffic_rl.settings`
#   (see docs/configuration.md, which is generated from the code).
# * Long-lived AWS keys are for local development only. Production uses
#   `AWS_ROLE_ARN` (OIDC/STS) or the task/execution role.
# =============================================================================

# -----------------------------------------------------------------------------
# Core run identity
# -----------------------------------------------------------------------------
TRAFFIC_RL_ENV=local                 # local | dev | staging | prod | ci
TRAFFIC_RL_CONFIG=configs/base.yaml  # YAML config (see configs/)
EXPERIMENT_NAME=traffic-rl-smoke     # groups runs in tracking/artefacts
RUN_ID=                              # leave empty to auto-generate
SEED=42
DRY_RUN=false                        # true = no AWS calls, no uploads
RUNS_DIR=runs
DATA_DIR=data
MAX_PARALLEL_ENVS=4                  # vectorised SUMO workers
TORCH_NUM_THREADS=0                  # 0 = let torch decide
DETERMINISTIC=true
TEST_REPORT_PATH=reports/test-report.json

# -----------------------------------------------------------------------------
# Structured logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                      # json (machine) | console (human)
LOG_DIR=logs
LOG_USE_QUEUE=true                   # async logging during SUMO stepping
LOG_MAX_BYTES=52428800
LOG_BACKUP_COUNT=5

# -----------------------------------------------------------------------------
# SUMO
# -----------------------------------------------------------------------------
SUMO_HOME=                           # e.g. C:\Program Files (x86)\Eclipse\Sumo
SUMO_BINARY=                         # optional explicit path to sumo
SUMO_GUI_BINARY=                     # optional explicit path to sumo-gui
SUMO_PORT_START=8813                 # traci port pool for vectorised envs
SUMO_PORT_END=8900
SUMO_EXTRA_ARGS=                     # e.g. --no-step-log true

# -----------------------------------------------------------------------------
# AWS identity (region/account are not secrets)
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=000000000000
AWS_PROFILE=                         # local dev named profile
AWS_ROLE_ARN=                        # arn:aws:iam::<acct>:role/traffic-rl-github-oidc
AWS_ACCESS_KEY_ID=                   # LOCAL ONLY - never set in CI
AWS_SECRET_ACCESS_KEY=               # LOCAL ONLY - never set in CI
AWS_SESSION_TOKEN=                   # LOCAL ONLY
AWS_ENDPOINT_URL=                    # http://localhost:4566 for LocalStack

# -----------------------------------------------------------------------------
# S3 artefact/data buckets
# -----------------------------------------------------------------------------
S3_ARTIFACT_BUCKET=traffic-rl-artifacts
S3_DATA_BUCKET=                      # calibrated demand / detector counts
S3_SCENARIO_BUCKET=                  # generated scenario library
S3_PREFIX=traffic-rl
S3_KMS_KEY_ID=                       # SSE-KMS key for artefacts
S3_LIFECYCLE_DAYS=90
S3_MULTIPART_THRESHOLD_MB=64

# -----------------------------------------------------------------------------
# SageMaker (training, HPO, evaluation, endpoints)
# -----------------------------------------------------------------------------
SAGEMAKER_ROLE_ARN=                  # arn:aws:iam::<acct>:role/traffic-rl-sagemaker-exec
SAGEMAKER_INSTANCE_TYPE=ml.g5.2xlarge
SAGEMAKER_VOLUME_SIZE_GB=100
SAGEMAKER_USE_SPOT=true
SAGEMAKER_MAX_RUNTIME_S=86400
SAGEMAKER_MAX_WAIT_S=93600
SAGEMAKER_KEEP_ALIVE_PERIOD_S=1800
SAGEMAKER_TRAINING_IMAGE_URI=        # <acct>.dkr.ecr.<region>.amazonaws.com/traffic-rl:<sha>
SAGEMAKER_OUTPUT_PREFIX=sagemaker-output
SAGEMAKER_PROCESSING_INSTANCE_TYPE=ml.m5.2xlarge
SAGEMAKER_ENDPOINT_INSTANCE_TYPE=ml.g4dn.xlarge
SAGEMAKER_ENDPOINT_NAME=traffic-rl-policy
SAGEMAKER_MODEL_PACKAGE_GROUP=traffic-rl-policies
SAGEMAKER_HPO_MAX_JOBS=20
SAGEMAKER_HPO_MAX_PARALLEL_JOBS=4
SAGEMAKER_HPO_STRATEGY=Bayesian       # Bayesian | Random | Hyperband | Grid

# -----------------------------------------------------------------------------
# Container registry
# -----------------------------------------------------------------------------
ECR_REGISTRY=                        # <acct>.dkr.ecr.<region>.amazonaws.com
ECR_REPOSITORY=traffic-rl
IMAGE_TAG=latest

# -----------------------------------------------------------------------------
# Secret stores (runtime lookups; values are never written to disk)
# -----------------------------------------------------------------------------
SSM_PREFIX=/traffic-rl
SECRETS_PREFIX=traffic-rl

# -----------------------------------------------------------------------------
# Experiment tracking / metrics sinks
# -----------------------------------------------------------------------------
TRACKING_SINKS=jsonl                 # jsonl,tensorboard,cloudwatch,sagemaker
TENSORBOARD_ENABLED=true
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT=traffic-rl
WANDB_PROJECT=
WANDB_API_KEY=                       # secret
CLOUDWATCH_NAMESPACE=TrafficRL
CLOUDWATCH_LOG_GROUP=/traffic-rl/{{env}}

# -----------------------------------------------------------------------------
# Notifications
# -----------------------------------------------------------------------------
SNS_TOPIC_ARN=                       # pipeline success/failure alerts
SLACK_WEBHOOK_URL=                   # secret
